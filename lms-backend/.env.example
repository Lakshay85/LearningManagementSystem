# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=root
DATABASE_NAME=lms

# JWT Secrets
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Server
PORT=3000
NODE_ENV=development

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=uploads
STORAGE_BASE_URL=http://localhost:3000

# ============================================
# LLM Provider Configuration
# ============================================
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
NVIDIA_API_KEY=your-nvidia-api-key

# Optional Alternative Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=1024

# ============================================
# RAG Configuration
# ============================================
CHUNKING_STRATEGY=RECURSIVE
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
SENTENCE_OVERLAP=2
USE_STRUCTURED_PIPELINE=true

SEARCH_MODE=hybrid
TOP_K=10
ENABLE_RERANKING=true
RERANK_TOP_K=10

SIMILARITY_THRESHOLD=0.30
FALLBACK_SIMILARITY_THRESHOLD=0.20
MIN_CONTEXT_LENGTH=50
MIN_QUERY_WORDS_FOR_REFINEMENT=4

# ============================================
# Ingestion Queue & Intent Detection
# ============================================
INGESTION_CONCURRENCY=2
MAX_FILE_SIZE_MB=50

USE_INTENT_DETECTION=true
INTENT_CACHE_TTL_MS=300000
INTENT_CACHE_MAX_SIZE=1000
INTENT_CONFIDENCE_THRESHOLD=0.7
MAX_QUERY_LENGTH=5000
CONVERSATION_HISTORY_SIZE=10

# Razorpay TEST keys only (rzp_test_...). Live keys are always refused by the code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:5174

