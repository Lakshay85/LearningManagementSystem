# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/lmsrag

# Security - Generate a strong random key for production
RAG_API_KEY=your-secret-api-key-here-change-this

# JWT Secret (must match LMS backend for shared authentication)
JWT_ACCESS_SECRET=your-jwt-secret-here-change-this

# Redis for Chat Memory Caching and Queue
REDIS_URL=redis://:lms_redis_password@localhost:6379

# RabbitMQ for Event Messaging
RABBITMQ_URL=amqp://lms_user:lms_password@localhost:5672/lms_vhost

# ============================================
# LLM Provider Configuration
# ============================================

# Primary LLM Provider: 'groq' or 'openai'
LLM_PROVIDER=groq

# Groq Configuration - Get free API key from: https://console.groq.com/keys
# Groq provides fast inference for open-source models like LLaMA
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (required for embeddings, optional for LLM)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Embedding Configuration
# ============================================

# Embedding Provider: 'nvidia' (recommended), 'openai', or 'gemini'
EMBEDDING_PROVIDER=nvidia

# NVIDIA Configuration - Get free API key from: https://build.nvidia.com/
# NVIDIA provides state-of-the-art embeddings with bge-m3 model
NVIDIA_API_KEY=your-nvidia-api-key-here

# NVIDIA Embedding Model (bge-m3 is recommended for best retrieval quality)
EMBEDDING_MODEL=baai/bge-m3

# OpenAI Embedding Model (alternative)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (1024 for NVIDIA bge-m3, 1536 for OpenAI, 3072 for Gemini)
EMBEDDING_DIMENSIONS=1024

# ============================================
# RAG Configuration
# ============================================

# Chunking: Handled by SmartChunker via StructuredIngestionPipeline
CHUNK_SIZE=1500
MIN_CHUNK_SIZE=100
SENTENCE_OVERLAP=2

# Search: Vector similarity with context expansion
# TOP_K is the initial retrieval count before context expansion
TOP_K=20

# Similarity thresholds for retrieval
SIMILARITY_THRESHOLD=0.25
FALLBACK_SIMILARITY_THRESHOLD=0.15

# Context expansion: fetch adjacent chunks for comprehensive answers
CONTEXT_WINDOW_SIZE=2

# ============================================
# Async Ingestion Queue
# ============================================

# Number of concurrent ingestion jobs
INGESTION_CONCURRENCY=2

# Maximum file size for ingestion (in MB)
MAX_FILE_SIZE_MB=50

# ============================================
# CORS Configuration
# ============================================

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ============================================
# Logging Configuration
# ============================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable structured JSON logging for production
JSON_LOGS=false
